# Copy this file to .env for local dev. On Render, set these as
# Environment Variables in the dashboard instead - don't commit a real .env.

# MongoDB Atlas connection string (free M0 cluster is enough).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/ephemeral-chat
MONGODB_URI=

# Port Render provides this automatically - only needed for local dev.
PORT=3000

# --- Optional WhatsApp bridge (Baileys) ---
# Read the warning at the top of whatsapp.js before enabling this.
ENABLE_WHATSAPP=false

# The phone number (digits only, country code, no +) that the bridge
# talks to, e.g. 15551234567 for a US number.
WHATSAPP_BRIDGE_TARGET=

# The in-app handle that incoming WhatsApp messages should be delivered
# to (this should be your own registered handle).
WHATSAPP_APP_USERNAME=
