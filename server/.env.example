# Copy this file to .env for local dev. On Render, set these as
# Environment Variables in the dashboard instead - don't commit a real .env.

# MongoDB Atlas connection string (free M0 cluster is enough).
<<<<<<< HEAD
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/ephemeral-chat
=======
>>>>>>> ddb839a (Ephemeral chat)
MONGODB_URI=

# Any long random string - signs session tokens and hashes OTP codes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only needed for local dev - Render provides PORT automatically.
PORT=3000

# Lets you link the shared "verifier" WhatsApp bot (see README) that
# delivers phone-login codes, via /api/admin/verifier/qr?token=...
# Pick any long random string. Leave blank to disable admin routes.
ADMIN_TOKEN=

# If true, and the verifier bot isn't linked yet, /api/auth/request-code
# returns the code directly in the response (and logs it) instead of
# failing - useful for local testing, NEVER enable in a real deployment.
DEV_MODE=false
